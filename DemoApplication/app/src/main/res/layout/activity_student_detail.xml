<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="?attr/colorOnPrimary"
        android:title="Student Details" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">



        <!-- Big circular avatar -->
        <TextView
            android:id="@+id/textDetailAvatar"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:gravity="center"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="#6200EE"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/textDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textDetailAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Age: 0"
            android:textSize="18sp"
            android:textColor="#424242"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <so.plotline.insights.PlotlineWidget
            android:id= "@+id/native3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/textDetailCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Course"
            android:textSize="18sp"
            android:textColor="#6200EE"
            android:gravity="center" />



    </LinearLayout>

</LinearLayout>